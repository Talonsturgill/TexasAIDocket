#!/usr/bin/env bash
# ACTOR STAMP, carried into the commit so CI can read it.
#
# The pre-commit hook checks the staged change against the lane it resolves. CI cannot see local
# state, so until 2026-08-16 it fell back to pinning one actor from the branch prefix and
# checking the whole branch diff. That made a lane mean something different on the runner than it
# meant here, and the daily routine's own Phase 17, which changes lane and commits on a
# `claude/daily-` branch, sat exactly on the disagreement.
#
# This hook copies the stamp into the commit message as an `Actor:` trailer. One stamp, written
# once at a routine's Phase 0, now drives both checkers.
#
# An unstamped commit gets no trailer, which is correct: `--diff-per-commit` falls back to the
# branch's own actor, so a maintainer typing an ordinary commit needs to know none of this.
set -uo pipefail

msg_file="$1"
root="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
# Found through git rev-parse, never by joining "$root/.git". See the note in pre-commit: in a
# linked worktree that join points under a FILE and the stamp is never found, so every commit
# made in a worktree reached CI unstamped.
gitdir="$(git rev-parse --git-dir 2>/dev/null || echo "$root/.git")"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"

# THE LANE IS RESOLVED THE SAME WAY THE pre-commit HOOK RESOLVES IT, through one function in the
# checker, so the two cannot drift into disagreeing about which lane a commit is in. Nothing has
# to be written first: TXDOCKET_ACTOR narrows a lane for one command, an ACTOR file is honoured
# if some other process left one, and otherwise the branch prefix answers. See resolve_actor().
checker="$root/scripts/shared/ownership_check.py"
[ -f "$checker" ] || exit 0
actor="$(python3 "$checker" --print-actor --branch "$branch" --gitdir "$gitdir" 2>/dev/null \
         | tr -d '[:space:]')"
[ -n "$actor" ] || exit 0

# A maintainer session needs to know none of this, and an unstamped commit is judged against the
# branch's own actor by CI anyway, so there is nothing to declare.
#
# THAT IS ONLY TRUE WHEN THE BRANCH ITSELF RESOLVES TO `human`, and assuming it always did cost
# a red CI run on 2026-09-03. `ownership.yaml` grants `human` on `claude/daily-` branches through
# `branch_also_allows`, as the escape hatch for a run that has to fix a file it does not own. A
# maintainer used it, the pre-commit check passed because `human` owns every path, this hook
# wrote no trailer because the actor was `human`, and CI then inferred `daily` from the branch
# prefix and failed the commit for writing `config/schema_contract.json`.
#
# So the two halves disagreed about a lane the map explicitly permits. The skip now asks whether
# the BRANCH would have said `human` on its own. When it would, there is still nothing to
# declare. When it would not, the stamp is the only thing that can tell CI what happened.
branch_actor="$(env -u TXDOCKET_ACTOR python3 "$checker" --print-actor --branch "$branch" \
                --gitdir /nonexistent 2>/dev/null | tr -d '[:space:]')"
[ "$actor" = "human" ] && [ "$branch_actor" = "human" ] && exit 0

# Already stamped, by an amend or a cherry-pick carrying the trailer forward. Leave it alone
# rather than stacking a second one, which would leave the two disagreeing with no rule for
# which wins.
if grep -qiE '^[[:space:]]*Actor:[[:space:]]*[A-Za-z0-9_-]+[[:space:]]*$' "$msg_file"; then
  exit 0
fi

# A trailer has to be the last block and separated from the body by a blank line, or git
# interpret-trailers and the checker's regex disagree about where the message ends.
printf '\nActor: %s\n' "$actor" >> "$msg_file"
exit 0
